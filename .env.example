# Copy these into Vercel > Project > Settings > Environment Variables (never commit real values).

# Public website address, used for canonical links and the sitemap (optional on Vercel)
SITE_URL=https://www.your-domain.com

# Google Analytics 4 measurement ID (optional; leave empty to switch analytics off)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Email delivery through resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
FROM_EMAIL=GAA Group <enquiries@your-domain.com>

# Where enquiries go (comma-separate several addresses)
TEAM_EMAIL_GAA_CONSULTING=advisory@your-domain.com
TEAM_EMAIL_FILINGS_FIRST=accounts@your-domain.com
TEAM_EMAIL_HIRINGS_FIRST=careers@your-domain.com
TEAM_EMAIL_DEFAULT=hello@your-domain.com

# Optional: send every lead to your CRM or automation tool (Zoho, HubSpot, Zapier, Make...)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
